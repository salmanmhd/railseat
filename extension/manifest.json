{
  "manifest_version": 3,
  "name": "RailSeat",
  "version": "0.1.0",
  "description": "Find confirmed IRCTC seats from a side panel, using your own browser session.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open RailSeat",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.irctc.co.in/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
